# Discord bot token from the Discord Developer Portal (Bot page, "Reset Token").
DISCORD_BOT_TOKEN=

# Postgres connection string for the same database Planka uses.
# Format: postgres://user:password@host:port/database
DATABASE_URL=

# Port for the internal HTTP server (POST /dm) that the Planka backend calls
# to trigger DMs. Optional, defaults to 4000.
PORT=4000

# Shared secret the Planka backend must send as the X-Bot-Secret header when
# calling POST /dm. Required — requests without a matching header get 401.
# Example value below is randomly generated and safe to see in this file;
# generate your own for real use with: openssl rand -hex 32
BOT_SERVICE_SECRET=15769983fa7c62ea05c1d2e963d5df9272bee3051457b096896171d2ad7b1dd1
